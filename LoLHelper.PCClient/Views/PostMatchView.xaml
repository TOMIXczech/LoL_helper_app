<UserControl x:Class="LoLHelper.PCClient.Views.PostMatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="POST-MATCH ANALYSIS" Foreground="#FFFFFF" FontSize="22" FontWeight="Black" Margin="0,0,0,10"/>
        <TextBlock Text="Recent Match: Victory (Ranked Solo/Duo)" Foreground="#A3BE8C" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1C1C21" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="KDA" Foreground="#8F91A3" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="12 / 2 / 8" Foreground="White" FontSize="20" FontWeight="Black"/>
                    <TextBlock Text="10.0 Ratio" Foreground="#EBCB8B" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#1C1C21" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="CS / MIN" Foreground="#8F91A3" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="8.4" Foreground="White" FontSize="20" FontWeight="Black"/>
                    <TextBlock Text="Excellent" Foreground="#A3BE8C" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="#1C1C21" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="VISION SCORE" Foreground="#8F91A3" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="32" Foreground="White" FontSize="20" FontWeight="Black"/>
                    <TextBlock Text="Above Average" Foreground="#A3BE8C" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1C1C21" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="DAMAGE DEALT TO CHAMPIONS" Foreground="#8F91A3" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="You (Yasuo)" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                    <ProgressBar Grid.Column="1" Value="100" Maximum="100" Height="15" Foreground="#007ACC" Background="#2D2D35" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" Text="45,231" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ally ADC" Foreground="#8F91A3" FontWeight="SemiBold"/>
                    <ProgressBar Grid.Column="1" Value="75" Maximum="100" Height="15" Foreground="#A3BE8C" Background="#2D2D35" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" Text="33,102" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ally Mid" Foreground="#8F91A3" FontWeight="SemiBold"/>
                    <ProgressBar Grid.Column="1" Value="50" Maximum="100" Height="15" Foreground="#A3BE8C" Background="#2D2D35" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" Text="22,400" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
