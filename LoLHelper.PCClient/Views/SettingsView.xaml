<UserControl x:Class="LoLHelper.PCClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="PENGU LOADER CUSTOMIZATION" Foreground="#FFFFFF" FontSize="22" FontWeight="Black" Margin="0,0,0,20"/>
            
            <Border Background="#1C1C21" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="ElainaV4 Theme Background" Foreground="#8F91A3" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Select a custom image to overwrite the League Client background." Foreground="White" Margin="0,0,0,15"/>
                    
                    <Button x:Name="BrowseBgBtn" 
                            Content="Select Background Image..." 
                            Height="35" Width="250" HorizontalAlignment="Left" Margin="0,0,0,5"
                            Background="#2D2D35" Foreground="#E0E0E0" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            Click="BrowseBgBtn_Click"/>
                    
                    <TextBlock x:Name="SelectedBgText" 
                               Text="No image selected" 
                               Foreground="#8F91A3" FontSize="11" Margin="0,0,0,20" 
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="InstallElainaBtn" 
                            Content="Apply Theme to Client" 
                            Height="45" Width="250" HorizontalAlignment="Left"
                            Background="#E84057" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand"
                            Click="InstallElainaBtn_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
