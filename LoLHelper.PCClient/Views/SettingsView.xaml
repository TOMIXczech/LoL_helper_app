<UserControl x:Class="LoLHelper.PCClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#090B10"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- ==================== THIN MINIMAL SCROLLBAR ==================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#121622" Width="4">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2CE5B5" Opacity="0.65"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== SHARP SQUARE CHECKBOX (LIKE SCREENSHOT) ==================== -->
        <Style x:Key="SharpCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#9BA3BA"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ChkBox"
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="0"
                                    Background="#05070B"
                                    BorderBrush="#3D4663"
                                    BorderThickness="1.3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Path x:Name="ChkMark"
                                      Data="M 2.5,8 L 6,11.5 L 13,3.5"
                                      Stroke="#2CE5B5"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ChkBox" Property="BorderBrush" Value="#2CE5B5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChkBox" Property="BorderBrush" Value="#5383E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#E6ECF8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== SHARP RECTANGULAR OUTLINED BUTTON (LIKE "OPEN BACKGROUNDS'S FOLDER") ==================== -->
        <Style x:Key="SharpBoxButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1E29"/>
            <Setter Property="Foreground" Value="#B8C0D8"/>
            <Setter Property="BorderBrush" Value="#2CE5B5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="24,11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#23293A"/>
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#5383E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#12151E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== SHARP RECTANGULAR TEXTBOX (LIKE "3000" / "100" / "10000" IN SCREENSHOT) ==================== -->
        <Style x:Key="SharpInputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#030508"/>
            <Setter Property="Foreground" Value="#B8C0D8"/>
            <Setter Property="CaretBrush" Value="#2CE5B5"/>
            <Setter Property="BorderBrush" Value="#3D4663"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtBd" Property="BorderBrush" Value="#5383E8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TxtBd" Property="BorderBrush" Value="#2CE5B5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== ORNATE DOUBLE-DIAMOND SLIDER (EXACT MATCH TO SCREENSHOT) ==================== -->
        <Style x:Key="DoubleDiamondSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Thin Horizontal Track Line -->
                            <Border Height="2.5" Background="#1D2230" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="26" Height="26">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="26" Height="26" Background="Transparent">
                                                    <!-- Outer Rotated Diamond -->
                                                    <Border x:Name="OuterDiamond"
                                                            Width="17"
                                                            Height="17"
                                                            Background="#090B10"
                                                            BorderBrush="#2CE5B5"
                                                            BorderThickness="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <RotateTransform Angle="45"/>
                                                        </Border.RenderTransform>
                                                        <!-- Inner Rotated Diamond -->
                                                        <Border Width="7"
                                                                Height="7"
                                                                Background="Transparent"
                                                                BorderBrush="#2CE5B5"
                                                                BorderThickness="1.5"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OuterDiamond" Property="BorderBrush" Value="#5383E8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== SHARP RECTANGULAR COMBOBOX ==================== -->
        <Style x:Key="SharpComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0A0D14"/>
            <Setter Property="Foreground" Value="#B8C0D8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" BorderBrush="#181C29" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1B2133"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#122928"/>
                    <Setter Property="Foreground" Value="#2CE5B5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SharpComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#B8C0D8"/>
            <Setter Property="Background" Value="#030508"/>
            <Setter Property="BorderBrush" Value="#3D4663"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SharpComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Path Data="M 0,4 L 4,0 L 8,4 Z" Fill="#2CE5B5" Margin="0,0,0,2"/>
                                                    <Path Data="M 0,0 L 4,4 L 8,0 Z" Fill="#2CE5B5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxBd" Property="BorderBrush" Value="#2CE5B5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="280">
                                    <Border Background="#0A0D14" BorderBrush="#2CE5B5" BorderThickness="1" CornerRadius="0">
                                        <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== LEFT SIDEBAR NAV ITEM ==================== -->
        <Style x:Key="SidebarNavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="NavGrid" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" Margin="18,0,10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavGrid" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1B2133" Offset="0"/>
                                            <GradientStop Color="#00090B10" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#090B10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP HEADER BAR ==================== -->
        <Grid Grid.Row="0" Margin="28,0,28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CLIENT  /  " Foreground="#8E92A4" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderCategoryTitleText" Text="AUTOMATION" Foreground="White" FontSize="17" FontWeight="Black" VerticalAlignment="Center"/>

                <TextBlock x:Name="AutomationLiveStatusText" Text="• AUTOMATION READY" Foreground="#2CE5B5" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>

            <Button x:Name="ResetDefaultsBtn"
                    Style="{StaticResource SharpBoxButtonStyle}"
                    Content="RESTORE DEFAULTS"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    BorderBrush="#3D4663"
                    Click="ResetDefaultsBtn_Click"/>
        </Grid>

        <!-- Top Horizontal Line -->
        <Border Grid.Row="1" Background="#1C2130"/>

        <!-- ==================== ROW 2: LEFT SIDEBAR + VERTICAL BAR + OPEN BORDERLESS CONTENT ==================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT SIDEBAR MENU ==================== -->
            <StackPanel Grid.Column="0" Margin="0,6,10,0">
                <TextBlock Text="AUTOMATION" Foreground="#626880" FontSize="11" FontWeight="Bold" Margin="18,6,0,8"/>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarAllAutomation" Width="3" HorizontalAlignment="Left" Background="#2CE5B5"/>
                    <Button x:Name="NavBtnAllAutomation" Content="ALL AUTOMATION" Style="{StaticResource SidebarNavBtnStyle}" Foreground="White" Tag="ALL_AUTOMATION" Click="SidebarNav_Click"/>
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarAutoAccept" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                    <Button x:Name="NavBtnAutoAccept" Content="AUTO ACCEPT" Style="{StaticResource SidebarNavBtnStyle}" Tag="AUTO_ACCEPT" Click="SidebarNav_Click"/>
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarChampSelect" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                    <Button x:Name="NavBtnChampSelect" Content="AUTO CHAMP &amp; COUNTERS" Style="{StaticResource SidebarNavBtnStyle}" Tag="AUTO_CHAMP" Click="SidebarNav_Click"/>
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarBanEngine" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                    <Button x:Name="NavBtnBanEngine" Content="AUTO BAN &amp; COUNTERS" Style="{StaticResource SidebarNavBtnStyle}" Tag="AUTO_BAN" Click="SidebarNav_Click"/>
                </Grid>

                <TextBlock Text="MASTERY &amp; LOADOUT" Foreground="#626880" FontSize="11" FontWeight="Bold" Margin="18,22,0,8"/>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarMastery" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                    <Button x:Name="NavBtnMastery" Content="MASTERY COUNTER POOL" Style="{StaticResource SidebarNavBtnStyle}" Tag="MASTERY_POOL" Click="SidebarNav_Click"/>
                </Grid>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarLoadout" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                    <Button x:Name="NavBtnLoadout" Content="RUNES, SPELLS &amp; ITEMS" Style="{StaticResource SidebarNavBtnStyle}" Tag="LOADOUT" Click="SidebarNav_Click"/>
                </Grid>

                <TextBlock Text="RECOMMENDATIONS" Foreground="#626880" FontSize="11" FontWeight="Bold" Margin="18,22,0,8"/>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarSuggestions" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                    <Button x:Name="NavBtnSuggestions" Content="SUGGESTIONS CONFIG" Style="{StaticResource SidebarNavBtnStyle}" Tag="SUGGESTIONS" Click="SidebarNav_Click"/>
                </Grid>

                <TextBlock Text="IN-GAME" Foreground="#626880" FontSize="11" FontWeight="Bold" Margin="18,22,0,8"/>

                <Grid Margin="0,0,0,2">
                    <Border x:Name="NavBarPreview" Width="3" HorizontalAlignment="Left" Background="Transparent"/>
                    <Button x:Name="NavBtnPreview" Content="COUNTER SIMULATOR" Style="{StaticResource SidebarNavBtnStyle}" Tag="SIMULATOR" Click="SidebarNav_Click"/>
                </Grid>
            </StackPanel>

            <!-- Vertical Divider Line -->
            <Border Grid.Column="1" Width="3" Background="#252C40" Margin="0,4,0,24"/>

            <!-- ==================== RIGHT OPEN CONTENT CANVAS (EXACT LAYOUT LIKE SCREENSHOT) ==================== -->
            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="38,8,40,36">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                    <!-- ==================== SECTION 1: AUTO ACCEPT ==================== -->
                    <StackPanel x:Name="SectionAutoAccept" Margin="0,0,0,42">
                        <TextBlock Text="AUTO ACCEPT" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,22"/>

                        <StackPanel Margin="26,0,0,0">
                            <CheckBox x:Name="AutoAcceptMasterSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="ENABLE AUTO ACCEPT MATCH READY CHECK"
                                      Click="AutoAcceptMasterSwitch_Click"/>

                            <CheckBox x:Name="PartyLeaderOnlySwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTO ACCEPT ONLY WHEN YOU ARE PARTY LEADER"
                                      Click="AnyToggle_Click"/>

                            <CheckBox x:Name="PauseAfterDeclineSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="PAUSE AUTO ACCEPT AFTER MANUAL DECLINE"
                                      Click="AnyToggle_Click"/>

                            <!-- Text Input Box for Latency (like 3000 in screenshot) -->
                            <TextBlock Text="AUTO ACCEPT REACTION LATENCY WILL DELAY READY CHECK (PER MILLISECONDS)"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12"/>

                            <TextBox x:Name="AcceptDelayTextBox"
                                     Style="{StaticResource SharpInputTextBoxStyle}"
                                     Width="310"
                                     HorizontalAlignment="Left"
                                     Text="850"
                                     TextChanged="AcceptDelayTextBox_TextChanged"
                                     Margin="0,0,0,28"/>

                            <!-- Double-Diamond Slider (like WALLPAPER VOLUME: 0 in screenshot) -->
                            <TextBlock x:Name="AcceptDelayValueText"
                                       Text="ACCEPT LATENCY SLIDER: 850 MS"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Slider x:Name="AcceptDelaySlider"
                                    Style="{StaticResource DoubleDiamondSliderStyle}"
                                    Width="640"
                                    HorizontalAlignment="Left"
                                    Minimum="0" Maximum="8000" TickFrequency="50" IsSnapToTickEnabled="True"
                                    ValueChanged="AcceptDelaySlider_ValueChanged"
                                    Margin="0,0,0,26"/>

                            <!-- Inline Label + Input Box + Unit Symbol (like WALLPAPER SPEED [ 100 ] % in screenshot) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,30">
                                <TextBlock Text="HUMAN RANDOM JITTER"
                                           Foreground="#9BA3BA"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0"/>

                                <TextBox x:Name="AcceptJitterTextBox"
                                         Style="{StaticResource SharpInputTextBoxStyle}"
                                         Width="260"
                                         Text="150"
                                         TextChanged="AcceptJitterTextBox_TextChanged"/>

                                <TextBlock Text="ms"
                                           Foreground="#9BA3BA"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"/>
                            </StackPanel>

                            <Slider x:Name="AcceptJitterSlider"
                                    Style="{StaticResource DoubleDiamondSliderStyle}"
                                    Width="640"
                                    HorizontalAlignment="Left"
                                    Minimum="0" Maximum="1000" TickFrequency="25" IsSnapToTickEnabled="True"
                                    ValueChanged="AcceptJitterSlider_ValueChanged"
                                     Visibility="Collapsed"/>
                            <TextBlock x:Name="AcceptJitterValueText" Visibility="Collapsed"/>

                            <!-- Queue Checkboxes -->
                            <CheckBox x:Name="QueueSoloCheck" Style="{StaticResource SharpCheckBoxStyle}" Content="AUTO ACCEPT RANKED SOLO / DUO" Click="AnyToggle_Click"/>
                            <CheckBox x:Name="QueueFlexCheck" Style="{StaticResource SharpCheckBoxStyle}" Content="AUTO ACCEPT RANKED FLEX 5V5" Click="AnyToggle_Click"/>
                            <CheckBox x:Name="QueueNormalCheck" Style="{StaticResource SharpCheckBoxStyle}" Content="AUTO ACCEPT NORMAL DRAFT &amp; QUICKPLAY" Click="AnyToggle_Click"/>
                            <CheckBox x:Name="QueueAramCheck" Style="{StaticResource SharpCheckBoxStyle}" Content="AUTO ACCEPT ARAM &amp; ROTATING MODES" Click="AnyToggle_Click" Margin="0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== SECTION 2: AUTO CHAMP SELECT & COUNTERS ==================== -->
                    <StackPanel x:Name="SectionChampSelect" Margin="0,0,0,42">
                        <TextBlock Text="AUTO CHAMP SELECT &amp; COUNTERS" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,22"/>

                        <StackPanel Margin="26,0,0,0">
                            <CheckBox x:Name="AutoChampSelectMasterSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="ENABLE AUTO CHAMP SELECT AUTOMATION"
                                      Click="AutoChampSelectMasterSwitch_Click"/>

                            <CheckBox x:Name="AutoHoverPickSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="HOVER INTENDED CHAMPION DURING PLANNING PHASE"
                                      Click="AnyToggle_Click"/>

                            <CheckBox x:Name="AutoLockInPickSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTOMATICALLY LOCK IN CHAMPION ON MY TURN"
                                      Click="AnyToggle_Click"/>

                            <!-- Pick Strategy Dropdown -->
                            <TextBlock Text="CHAMPION PICK STRATEGY MODE"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,10"/>

                            <ComboBox x:Name="PickStrategyCombo"
                                      Style="{StaticResource SharpComboBoxStyle}"
                                      Width="440"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="PickStrategyCombo_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="PICK SPECIFIC CHAMPION" Tag="SPECIFIC"/>
                                <ComboBoxItem Content="PICK BEST STATISTICAL COUNTER" Tag="BEST_COUNTER"/>
                                <ComboBoxItem Content="PICK COUNTER BASED ON MY CHAMPION MASTERY" Tag="MASTERY_COUNTER"/>
                            </ComboBox>

                            <TextBlock x:Name="PickStrategyHintText"
                                       Text="ALWAYS PICKS YOUR SELECTED PRIMARY CHAMPION (OR BACKUP IF BANNED/TAKEN)"
                                       Foreground="#2CE5B5"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,24"/>

                            <!-- Target Role Dropdown -->
                            <TextBlock Text="PREFERRED LANE / ROLE"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ComboBox x:Name="PreferredRoleCombo"
                                      Style="{StaticResource SharpComboBoxStyle}"
                                      Width="310"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="PreferredRoleCombo_SelectionChanged"
                                      Margin="0,0,0,24">
                                <ComboBoxItem Content="AUTO (LCU ASSIGNED)" Tag="AUTO"/>
                                <ComboBoxItem Content="TOP LANE" Tag="TOP"/>
                                <ComboBoxItem Content="JUNGLE" Tag="JUNGLE"/>
                                <ComboBoxItem Content="MID LANE" Tag="MIDDLE"/>
                                <ComboBoxItem Content="BOTTOM / ADC" Tag="BOTTOM"/>
                                <ComboBoxItem Content="SUPPORT / UTILITY" Tag="UTILITY"/>
                            </ComboBox>

                            <!-- Primary Champion Selector -->
                            <TextBlock Text="SPECIFIC PRIMARY CHAMPION TO PLAY"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Border Width="38" Height="38" BorderBrush="#2CE5B5" BorderThickness="1" Background="#030508" Margin="0,0,12,0">
                                    <Image x:Name="PrimaryPickChampImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <ComboBox x:Name="PrimaryPickCombo"
                                          Style="{StaticResource SharpComboBoxStyle}"
                                          Width="260"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectionChanged="PrimaryPickCombo_SelectionChanged"/>
                            </StackPanel>

                            <!-- Backup Champion Selector -->
                            <TextBlock Text="BACKUP CHAMPION (IF PRIMARY IS BANNED OR PICKED)"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                                <Border Width="38" Height="38" BorderBrush="#3D4663" BorderThickness="1" Background="#030508" Margin="0,0,12,0">
                                    <Image x:Name="BackupPickChampImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <ComboBox x:Name="BackupPickCombo"
                                          Style="{StaticResource SharpComboBoxStyle}"
                                          Width="260"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectionChanged="BackupPickCombo_SelectionChanged"/>
                            </StackPanel>

                            <!-- Pick Lock-In Delay Slider + Box (like CHANGE WALLPAPER SLIDE DELAY [ 10000 ]) -->
                            <TextBlock x:Name="PickDelayValueText"
                                       Text="PICK LOCK-IN DELAY: 1200 MS"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Slider x:Name="PickDelaySlider"
                                    Style="{StaticResource DoubleDiamondSliderStyle}"
                                    Width="640"
                                    HorizontalAlignment="Left"
                                    Minimum="0" Maximum="8000" TickFrequency="100" IsSnapToTickEnabled="True"
                                    ValueChanged="PickDelaySlider_ValueChanged"
                                    Margin="0,0,0,16"/>

                            <TextBlock Text="CHANGE PICK LOCK-IN DELAY (MILLISECONDS)"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBox x:Name="PickDelayTextBox"
                                     Style="{StaticResource SharpInputTextBoxStyle}"
                                     Width="310"
                                     HorizontalAlignment="Left"
                                     Text="1200"
                                     TextChanged="PickDelayTextBox_TextChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== SECTION 3: AUTO BAN & COUNTER-BAN ==================== -->
                    <StackPanel x:Name="SectionBanEngine" Margin="0,0,0,42">
                        <TextBlock Text="AUTO BAN &amp; COUNTERS" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,22"/>

                        <StackPanel Margin="26,0,0,0">
                            <CheckBox x:Name="AutoBanMasterSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="ENABLE AUTO BAN IN CHAMP SELECT"
                                      Click="AnyToggle_Click"/>

                            <CheckBox x:Name="ProtectAllyHoverSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="PROTECT TEAMMATE HOVER (NEVER BAN ALLY INTENT)"
                                      Click="AnyToggle_Click"/>

                            <TextBlock Text="CHAMPION BAN STRATEGY MODE"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,10"/>

                            <ComboBox x:Name="BanStrategyCombo"
                                      Style="{StaticResource SharpComboBoxStyle}"
                                      Width="460"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="BanStrategyCombo_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="BAN SPECIFIC CHAMPION" Tag="SPECIFIC"/>
                                <ComboBoxItem Content="BAN BIGGEST COUNTER OF CHAMP I WANT TO PLAY" Tag="BIGGEST_COUNTER"/>
                                <ComboBoxItem Content="BAN COUNTER OF COUNTER (PROTECT MY COUNTERPICK)" Tag="COUNTER_OF_COUNTER"/>
                            </ComboBox>

                            <TextBlock x:Name="BanStrategyHintText"
                                       Text="CALCULATES AND BANS THE #1 BIGGEST COUNTER TO THE CHAMPION YOU WANT TO PLAY"
                                       Foreground="#2CE5B5"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,24"/>

                            <!-- Specific Ban Selector -->
                            <TextBlock Text="SPECIFIC CHAMPION TO BAN"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Border Width="38" Height="38" BorderBrush="#E84057" BorderThickness="1" Background="#030508" Margin="0,0,12,0">
                                    <Image x:Name="PrimaryBanChampImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <ComboBox x:Name="PrimaryBanCombo"
                                          Style="{StaticResource SharpComboBoxStyle}"
                                          Width="260"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectionChanged="PrimaryBanCombo_SelectionChanged"/>
                            </StackPanel>

                            <!-- Backup Ban Selector -->
                            <TextBlock Text="BACKUP BAN (IF TEAMMATE HOVERS PRIMARY BAN)"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                                <Border Width="38" Height="38" BorderBrush="#3D4663" BorderThickness="1" Background="#030508" Margin="0,0,12,0">
                                    <Image x:Name="BackupBanChampImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <ComboBox x:Name="BackupBanCombo"
                                          Style="{StaticResource SharpComboBoxStyle}"
                                          Width="260"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectionChanged="BackupBanCombo_SelectionChanged"/>
                            </StackPanel>

                            <!-- Ban Delay Slider + Input Box -->
                            <TextBlock x:Name="BanDelayValueText"
                                       Text="BAN LOCK-IN DELAY: 900 MS"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Slider x:Name="BanDelaySlider"
                                    Style="{StaticResource DoubleDiamondSliderStyle}"
                                    Width="640"
                                    HorizontalAlignment="Left"
                                    Minimum="0" Maximum="6000" TickFrequency="100" IsSnapToTickEnabled="True"
                                    ValueChanged="BanDelaySlider_ValueChanged"
                                    Margin="0,0,0,16"/>

                            <TextBlock Text="CHANGE BAN LOCK-IN DELAY (MILLISECONDS)"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBox x:Name="BanDelayTextBox"
                                     Style="{StaticResource SharpInputTextBoxStyle}"
                                     Width="310"
                                     HorizontalAlignment="Left"
                                     Text="900"
                                     TextChanged="BanDelayTextBox_TextChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== SECTION 4: MASTERY COUNTER POOL ==================== -->
                    <StackPanel x:Name="SectionMastery" Margin="0,0,0,42">
                        <TextBlock Text="MASTERY COUNTER POOL" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,22"/>

                        <StackPanel Margin="26,0,0,0">
                            <!-- Framed Action Button (like OPEN BACKGROUNDS'S FOLDER in screenshot) -->
                            <Button x:Name="SyncLcuMasteryBtn"
                                    Style="{StaticResource SharpBoxButtonStyle}"
                                    Content="SYNC CHAMPION MASTERY POOL FROM LEAGUE CLIENT"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,26"
                                    Click="SyncLcuMasteryBtn_Click"/>

                            <TextBlock x:Name="MasteryLevelBadgeText"
                                       Text="MINIMUM MASTERY LEVEL FOR COUNTER: 5"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <Slider x:Name="MinMasterySlider"
                                    Style="{StaticResource DoubleDiamondSliderStyle}"
                                    Width="640"
                                    HorizontalAlignment="Left"
                                    Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="MinMasterySlider_ValueChanged"
                                    Margin="0,0,0,24"/>

                            <TextBlock Text="ADD CHAMPION TO MASTERY COUNTER POOL"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <ComboBox x:Name="AddMasteryChampCombo"
                                          Style="{StaticResource SharpComboBoxStyle}"
                                          Width="260"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Margin="0,0,12,0"/>
                                <Button Content="ADD TO MASTERY POOL" Style="{StaticResource SharpBoxButtonStyle}" Click="AddMasteryChampBtn_Click"/>
                            </StackPanel>

                            <TextBlock Text="ACTIVE MASTERY POOL CHAMPIONS (CLICK ANY ICON TO REMOVE)"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <WrapPanel x:Name="MasteryPoolWrapPanel" Width="640" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== SECTION 5: RUNES, SPELLS & ITEMS ==================== -->
                    <StackPanel x:Name="SectionLoadout" Margin="0,0,0,42">
                        <TextBlock Text="RUNES, SPELLS &amp; ITEMS" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,22"/>

                        <StackPanel Margin="26,0,0,0">
                            <CheckBox x:Name="AutoRunesSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTO EXPORT OPTIMAL RUNE PAGE ON LOCK-IN"
                                      Click="AnyToggle_Click"/>

                            <CheckBox x:Name="AutoSpellsSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTO EXPORT SUMMONER SPELLS ON LOCK-IN"
                                      Click="AnyToggle_Click"/>

                            <CheckBox x:Name="AutoItemsSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTO IMPORT RECOMMENDED ITEM BUILD TO SHOP"
                                      Click="AnyToggle_Click"/>

                            <CheckBox x:Name="AutoMatchupBuildSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTO ADAPT RUNES &amp; ITEMS TO ENEMY LANER MATCHUP"
                                      Click="AnyToggle_Click"/>

                            <CheckBox x:Name="AutoOpenBuildSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTO OPEN CHAMPION BUILD TAB ON LOCK-IN"
                                      Click="AnyToggle_Click"/>

                            <TextBlock Text="PREFERRED FLASH KEYBINDING SLOT"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,6,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="FlashKeyDBtn" Content="FLASH ON [ D ]" Style="{StaticResource SharpBoxButtonStyle}" Tag="D" Click="FlashKeyBtn_Click" Margin="0,0,14,0"/>
                                <Button x:Name="FlashKeyFBtn" Content="FLASH ON [ F ]" Style="{StaticResource SharpBoxButtonStyle}" Tag="F" Click="FlashKeyBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== SECTION 5.5: SUGGESTIONS CONFIG ==================== -->
                    <StackPanel x:Name="SectionSuggestions" Margin="0,0,0,42">
                        <TextBlock Text="PICK &amp; BAN SUGGESTIONS ENGINE" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,22"/>

                        <StackPanel Margin="26,0,0,0">
                            <CheckBox x:Name="PersonalizedModeSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="ENABLE PERSONALIZED MASTERY MODE (PRIORITIZE M5+ TOP 30 META CHAMPS)"
                                      Click="PersonalizedModeSwitch_Click"/>
                            <TextBlock Text="RECOMMENDED: Automatically moves your high mastery champions to the front (#1–#5) if they rank in Top 30 meta." Foreground="#6E748A" FontSize="10.5" Margin="28,-10,0,16"/>

                            <CheckBox x:Name="AutoDetectLaneInSuggestionsSwitch"
                                      Style="{StaticResource SharpCheckBoxStyle}"
                                      Content="AUTO-DETECT ASSIGNED LANE AND PREPICKED CHAMPION FROM LIVE LCU SESSION"
                                      Click="AutoDetectLaneInSuggestionsSwitch_Click"/>
                            <TextBlock Text="Automatically syncs the suggestions view to your live champ select role and prepicked champion intent." Foreground="#6E748A" FontSize="10.5" Margin="28,-10,0,16"/>

                            <!-- Min Matches Threshold -->
                            <TextBlock Text="MINIMUM MATCHES THRESHOLD PER ROLE (DEFAULT: 10,000):" Foreground="#B8C0D8" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBox x:Name="MinMatchesTextBox" Width="140" Height="36" Style="{StaticResource SharpInputTextBoxStyle}" Text="10000" TextChanged="MinMatchesTextBox_TextChanged"/>
                                <TextBlock Text="GAMES (Matches from Blitz.gg ranked solo stats)" Foreground="#8E92A4" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- Min Mastery Level for Personalized Injection -->
                            <TextBlock x:Name="MinMasteryLevelLabel" Text="MINIMUM MASTERY LEVEL REQUIRED FOR PRIORITY: LEVEL 5 (M5+)" Foreground="#B8C0D8" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,8"/>
                            <Slider x:Name="MinMasteryLevelSlider" Minimum="4" Maximum="10" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource DoubleDiamondSliderStyle}" ValueChanged="MinMasteryLevelSlider_ValueChanged" Margin="0,0,0,18"/>

                            <!-- Strict Cap Badge -->
                            <Border Background="#162232" BorderBrush="#2CE5B5" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="STRICT RECOMMENDATION LIMIT: MAX 10 CHAMPIONS" Foreground="#2CE5B5" FontSize="11.5" FontWeight="Bold"/>
                                        <TextBlock Text="The suggestion engine strictly caps all Pick and Ban recommendation lists to at most 10 champions." Foreground="#8E92A4" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== SECTION 6: COUNTER & BAN SIMULATOR ==================== -->
                    <StackPanel x:Name="SectionSimulator" Margin="0,0,0,18">
                        <TextBlock Text="COUNTER SIMULATOR" Foreground="White" FontSize="16" FontWeight="Black" Margin="0,0,0,22"/>

                        <StackPanel Margin="26,0,0,0">
                            <TextBlock Text="SIMULATE VS ENEMY LANER TO PREVIEW CALCULATED PICK &amp; COUNTER-BAN"
                                       Foreground="#9BA3BA"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                                <Border Width="38" Height="38" BorderBrush="#F0B232" BorderThickness="1" Background="#030508" Margin="0,0,12,0">
                                    <Image x:Name="SimulatedEnemyImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <ComboBox x:Name="SimulatedEnemyCombo"
                                          Style="{StaticResource SharpComboBoxStyle}"
                                          Width="260"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectionChanged="SimulatedEnemyCombo_SelectionChanged"/>
                            </StackPanel>

                            <Grid Width="640" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Calculated Pick -->
                                <Border Grid.Column="0" Background="#030508" BorderBrush="#2CE5B5" BorderThickness="1" Padding="16,12" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" BorderBrush="#2CE5B5" BorderThickness="1" Margin="0,0,12,0">
                                            <Image x:Name="PreviewPickImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="WILL PICK" Foreground="#2CE5B5" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="PreviewPickNameText" Text="YASUO" Foreground="White" FontSize="14" FontWeight="Black"/>
                                            <TextBlock x:Name="PreviewPickReasonText" Text="Specific Main" Foreground="#9BA3BA" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Width="24" Height="24" BorderBrush="#3D4663" BorderThickness="1" VerticalAlignment="Center" ToolTip="Backup Pick">
                                            <Image x:Name="PreviewBackupPickImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Calculated Ban -->
                                <Border Grid.Column="1" Background="#030508" BorderBrush="#E84057" BorderThickness="1" Padding="16,12" Margin="10,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="42" Height="42" BorderBrush="#E84057" BorderThickness="1" Margin="0,0,12,0">
                                            <Image x:Name="PreviewBanImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="WILL BAN" Foreground="#E84057" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="PreviewBanNameText" Text="VEX" Foreground="White" FontSize="14" FontWeight="Black"/>
                                            <TextBlock x:Name="PreviewBanReasonText" Text="#1 Counter to Yasuo" Foreground="#9BA3BA" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Width="24" Height="24" BorderBrush="#3D4663" BorderThickness="1" VerticalAlignment="Center" ToolTip="2nd Fallback Ban">
                                            <Image x:Name="PreviewBackupBanImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Horizontal Line -->
        <Border Grid.Row="3" Background="#1C2130"/>

        <!-- ==================== ROW 4: FRAMED "DONE" BUTTON ==================== -->
        <Grid Grid.Row="4" Background="#090B10">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#3D4663"
                    BorderThickness="1.5"
                    Padding="2"
                    Background="#090B10">
                <Button x:Name="BackBtn"
                        Style="{StaticResource SharpBoxButtonStyle}"
                        Content="DONE"
                        Width="154"
                        Height="36"
                        FontSize="13"
                        BorderBrush="#2CE5B5"
                        Click="BackBtn_Click"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
