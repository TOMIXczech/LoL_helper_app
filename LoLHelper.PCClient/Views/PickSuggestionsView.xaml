<UserControl x:Class="LoLHelper.PCClient.Views.PickSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0E12"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Thin Sleek ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#12141D" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2CE5B5" Opacity="0.6" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Role Filter Pill Style -->
        <Style x:Key="RolePillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#171A26"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252A3D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mode Toggle Button Style -->
        <Style x:Key="ModeToggleBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Sleek ComboBox Item Style -->
        <Style x:Key="SuggestionsComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0E121B"/>
            <Setter Property="Foreground" Value="#D8DFEE"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" BorderBrush="#1C2234" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#1C2438"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#142B28"/>
                    <Setter Property="Foreground" Value="#2CE5B5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark Sleek ComboBox Style -->
        <Style x:Key="SuggestionsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E2E8F5"/>
            <Setter Property="Background" Value="#10131E"/>
            <Setter Property="BorderBrush" Value="#2D354C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SuggestionsComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="▾" Foreground="#2CE5B5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxBd" Property="BorderBrush" Value="#2CE5B5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="320">
                                    <Border Background="#0C0F17" BorderBrush="#2CE5B5" BorderThickness="1" CornerRadius="6">
                                        <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Reset Button Style -->
        <Style x:Key="ResetRoundBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C2132"/>
            <Setter Property="BorderBrush" Value="#2E374E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6E6E"/>
                                <Setter TargetName="Bd" Property="Background" Value="#381D24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP HEADER BAR ==================== -->
        <Border Grid.Row="0" Background="#14161F" BorderBrush="#252A3E" BorderThickness="1" CornerRadius="10" Padding="18,12" Margin="0,0,0,12">
            <Grid>
                <!-- Left: Title & Mode Toggle Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡 PICK &amp; BAN SUGGESTIONS" Foreground="White" FontSize="16" FontWeight="Black"/>
                            <Border x:Name="LcuLiveStatusBadge" Background="#132F2C" BorderBrush="#2CE5B5" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LcuLiveStatusText" Text="● Blitz Meta (10k+ Games)" Foreground="#2CE5B5" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Top 10 Recommendations from Blitz.gg Overview &amp; Counter Engine (Strictly Max 10)" Foreground="#7E849B" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Main Mode Switches: Pick vs Ban -->
                    <Border Background="#0D0E12" BorderBrush="#252A3E" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ModePickBtn"
                                    Content="🎯 Pick Suggestions"
                                    Style="{StaticResource ModeToggleBtnStyle}"
                                    Background="#223B38"
                                    Foreground="#2CE5B5"
                                    Click="ModePickBtn_Click"/>
                            <Button x:Name="ModeBanBtn"
                                    Content="🚫 Ban Suggestions"
                                    Style="{StaticResource ModeToggleBtnStyle}"
                                    Background="Transparent"
                                    Foreground="#8E92A4"
                                    Click="ModeBanBtn_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Personalized Mode Toggle & Refresh Button -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PersonalizedModeBtn"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,10,0"
                            Click="PersonalizedModeBtn_Click"
                            ToolTip="Toggles priority for up to 5 of your M5+ Mastery champions in the Top 30 meta">
                        <Border x:Name="PersonalizedBorder" Background="#282618" BorderBrush="#F0B232" BorderThickness="1" CornerRadius="7" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⭐" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PersonalizedModeText" Text="Personalized Mastery: ON" Foreground="#F0B232" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button x:Name="RefreshBtn" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Click="RefreshBtn_Click">
                        <Border Background="#1C2132" BorderBrush="#2F364E" BorderThickness="1" CornerRadius="7" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻" FontSize="13" Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button x:Name="ConfigBtn" Cursor="Hand" Background="Transparent" BorderThickness="0" Click="ConfigBtn_Click" ToolTip="Open Suggestion &amp; Automation Preferences in Settings">
                        <Border Background="#1C2132" BorderBrush="#2F364E" BorderThickness="1" CornerRadius="7" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Config" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: ROLE FILTER STRIP & PREPICK / TARGET CHAMPION BAR ==================== -->
        <Border Grid.Row="1" Background="#14161F" BorderBrush="#252A3E" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Role Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ROLE / LANE:" Foreground="#7E849B" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="RoleAllBtn" Content="🌐 All Roles" Style="{StaticResource RolePillBtnStyle}" Background="#223454" Foreground="White" Tag="ALL" Click="RolePill_Click"/>
                    <Button x:Name="RoleTopBtn" Content="🛡️ Top" Style="{StaticResource RolePillBtnStyle}" Tag="TOP" Click="RolePill_Click"/>
                    <Button x:Name="RoleJungleBtn" Content="🌿 Jungle" Style="{StaticResource RolePillBtnStyle}" Tag="JUNGLE" Click="RolePill_Click"/>
                    <Button x:Name="RoleMidBtn" Content="⚡ Mid" Style="{StaticResource RolePillBtnStyle}" Tag="MIDDLE" Click="RolePill_Click"/>
                    <Button x:Name="RoleAdcBtn" Content="🏹 ADC / Bot" Style="{StaticResource RolePillBtnStyle}" Tag="BOTTOM" Click="RolePill_Click"/>
                    <Button x:Name="RoleSupportBtn" Content="💖 Support" Style="{StaticResource RolePillBtnStyle}" Tag="UTILITY" Click="RolePill_Click" Margin="0"/>
                </StackPanel>

                <!-- Prepick / Ban Target Selector Box -->
                <Border x:Name="PrepickSelectorBorder" Grid.Column="2" Background="#141724" BorderBrush="#252C3E" BorderThickness="1" CornerRadius="8" Padding="12,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PrepickLabelText" Text="TEST AGAINST ENEMY LANER:" Foreground="#8E95AA" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Champion Icon or Auto Globe Icon Box -->
                        <Border x:Name="PrepickImgBorder" Width="30" Height="30" CornerRadius="6" Background="#10131E" BorderBrush="#283045" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="PrepickPlaceholderIcon" Text="🌐" FontSize="14" Foreground="#2CE5B5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="PrepickChampImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Sleek Dark Styled Dropdown -->
                        <ComboBox x:Name="PrepickChampCombo"
                                  Width="220"
                                  Height="32"
                                  Style="{StaticResource SuggestionsComboBoxStyle}"
                                  SelectedValuePath="Id"
                                  VerticalAlignment="Center"
                                  SelectionChanged="PrepickChampCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" BorderBrush="#252E44" BorderThickness="1" ClipToBounds="True" Background="#101420" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E2E7F5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Quick Clear / Reset Button back to Live Auto-detect -->
                        <Button x:Name="ClearPrepickBtn"
                                Width="26"
                                Height="26"
                                Margin="6,0,0,0"
                                ToolTip="Reset to Live Auto-Detect from League Client"
                                Visibility="Collapsed"
                                Click="ClearPrepickBtn_Click"
                                Style="{StaticResource ResetRoundBtnStyle}">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#8E92A4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: TOP 10 RECOMMENDATIONS LIST ==================== -->
        <Border Grid.Row="2" Background="#14161F" BorderBrush="#252A3E" BorderThickness="1" CornerRadius="10" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Headers Bar -->
                <Grid Grid.Row="0" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="#" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="CHAMPION" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="STRATEGIC REASON &amp; BADGE" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="WIN RATE" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="PICK RATE" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="BAN RATE" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="GAMES" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="ACTIONS" Foreground="#6B7186" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SuggestionsListStack"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
