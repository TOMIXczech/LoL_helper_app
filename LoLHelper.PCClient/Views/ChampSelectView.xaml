<UserControl x:Class="LoLHelper.PCClient.Views.ChampSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0E12">
    <UserControl.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="5">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2D3142" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark-Themed ContextMenu & MenuItem Styles -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#161822"/>
            <Setter Property="BorderBrush" Value="#2D3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E5E9F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBd" Background="Transparent" CornerRadius="5" Padding="10,7" Margin="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="MenuBd" Property="Padding" Value="12,7"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBd" Property="Background" Value="#25293A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Filter Pill Style -->
        <Style x:Key="TopFilterPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#151720"/>
            <Setter Property="BorderBrush" Value="#262936"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C1F2B"/>
                    <Setter Property="BorderBrush" Value="#363B4E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented Sort Tab Button Style -->
        <Style x:Key="SortTabBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Background" Value="Transparent"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBd" Property="Background" Value="#222533"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopBannerBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#172828"/>
            <Setter Property="BorderBrush" Value="#2CE5B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3D3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP CONTROLS BAR ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Segmented Role Icons Bar -->
                <Border Background="#151720" BorderBrush="#262936" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                    <UniformGrid Columns="5" x:Name="RoleFilterGrid">
                        <UniformGrid.Resources>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Width" Value="38"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#202330"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A2E3F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </UniformGrid.Resources>
                        <ToggleButton x:Name="FilterTop" Click="RoleFilter_Click" Tag="TOP" ToolTip="Top">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-top.png" Width="20" Height="20" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterJgl" Click="RoleFilter_Click" Tag="JUNGLE" ToolTip="Jungle">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-jungle.png" Width="20" Height="20" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterMid" Click="RoleFilter_Click" Tag="MIDDLE" ToolTip="Middle">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-middle.png" Width="20" Height="20" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterBot" Click="RoleFilter_Click" Tag="BOTTOM" ToolTip="Bottom">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-bottom.png" Width="20" Height="20" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterSup" Click="RoleFilter_Click" Tag="UTILITY" ToolTip="Support">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-utility.png" Width="20" Height="20" Stretch="Uniform"/>
                        </ToggleButton>
                    </UniformGrid>
                </Border>

                <!-- Champion Selector Button -->
                <Border x:Name="ChampSelectBtn" Style="{StaticResource TopFilterPillStyle}" Padding="10,6" Margin="0,0,8,0" MouseLeftButtonDown="ChampSelectBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True" Margin="0,0,8,0" Background="#252836">
                            <Image x:Name="SelectedChampImg" Width="24" Height="24" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="SelectedChampNameText" Text="Aatrox" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="▾" Foreground="#8E92A4" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Tier Selector Dropdown (with Riot Rank Icon) -->
                <Border x:Name="TierSelectBtn" Style="{StaticResource TopFilterPillStyle}" Padding="11,6" Margin="0,0,8,0" MouseLeftButtonDown="TierSelectBtn_Click">
                    <Border.ContextMenu>
                        <ContextMenu x:Name="TierContextMenu"/>
                    </Border.ContextMenu>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="SelectedTierImg" Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-shared-components/global/default/emerald.png" Width="22" Height="22" Margin="0,0,7,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="SelectedTierText" Text="Emerald+" Foreground="#E5E9F0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="▾" Foreground="#8E92A4" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Select Matchup Button -->
                <Border x:Name="MatchupSelectBtn" Style="{StaticResource TopFilterPillStyle}" Padding="12,7" Margin="0,0,14,0" MouseLeftButtonDown="MatchupSelectBtn_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="SelectedMatchupImg" Width="20" Height="20" Margin="0,0,6,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="SelectedMatchupText" Text="Select Matchup" Foreground="#E5E9F0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="▾" Foreground="#8E92A4" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TopPatchText" Text="Patch: 26.22" Foreground="#8E92A4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border x:Name="DataSourceBadge" Background="#123532" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                    <TextBlock x:Name="DataSourceText" Text="● Live Blitz.gg" Foreground="#2CE5B5" FontSize="10" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== ROW 1: LIVE CHAMP SELECT AUTO-BAN & BAN SUGGESTION BANNER ==================== -->
        <Border x:Name="LiveAutomationBanner" Grid.Row="1" Background="#141824" BorderBrush="#252A3C" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Ban Suggestion Icon & Text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6" BorderBrush="#E84057" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,10,0" Background="#1B1E2B">
                        <Image x:Name="LiveBanTargetImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️ BAN SUGGESTION: " Foreground="#8A90A6" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="LiveBanTargetNameText" Text="Blitzcrank" Foreground="#E84057" FontSize="12.5" FontWeight="Black"/>
                        </StackPanel>
                        <TextBlock x:Name="LiveBanReasonText" Text="#1 Statistical Counter to your Prepick" Foreground="#C8CBD7" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Live Status & Engine Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                    <Border x:Name="LiveAutoBanStatusBadge" Background="#2A1B24" BorderBrush="#E84057" BorderThickness="1" CornerRadius="5" Padding="10,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LiveAutoBanStatusIcon" Text="🚫" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LiveAutoBanStatusText" Text="AUTO-BAN READY" Foreground="#FF6B7D" FontSize="11" FontWeight="Black"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Quick Link to Pick & Ban Suggestions View -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ViewAllBanSuggestionsBtn" Click="ViewAllBanSuggestionsBtn_Click" Style="{StaticResource TopBannerBtnStyle}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 Ban Suggestions (Top 10)" Foreground="#2CE5B5" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text=" →" Foreground="#2CE5B5" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: STATS BANNER ==================== -->
        <Border Grid.Row="2" Background="#13151C" BorderBrush="#20222D" BorderThickness="1" CornerRadius="8" Padding="20,12" Margin="0,0,0,12">
            <UniformGrid Columns="6">
                <!-- Tier -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Tier" Foreground="#8E92A4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <Border x:Name="StatTierBadge" Background="#1F2433" BorderBrush="#3B4254" BorderThickness="1.5" CornerRadius="4,4,10,10" Width="28" Height="28" HorizontalAlignment="Center">
                            <TextBlock x:Name="StatTierText" Text="B" Foreground="#7CE3C3" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Line X1="8" Y1="4" X2="0" Y2="42" Stroke="#202330" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Win Rate -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Win Rate" Foreground="#8E92A4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock x:Name="StatWinRateText" Text="49.8%" Foreground="#FF7A7A" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Line X1="8" Y1="4" X2="0" Y2="42" Stroke="#202330" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Win Rate Change -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Win Rate Change" Foreground="#8E92A4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock x:Name="StatWinRateChangeText" Text="-0.3%" Foreground="#E5E9F0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Line X1="8" Y1="4" X2="0" Y2="42" Stroke="#202330" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Pick rate -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Pick rate" Foreground="#8E92A4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock x:Name="StatPickRateText" Text="3.5%" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Line X1="8" Y1="4" X2="0" Y2="42" Stroke="#202330" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Ban rate -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Ban rate" Foreground="#8E92A4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock x:Name="StatBanRateText" Text="4.0%" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Line X1="8" Y1="4" X2="0" Y2="42" Stroke="#202330" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Matches -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Matches" Foreground="#8E92A4" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBlock x:Name="StatMatchesText" Text="22,274" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ==================== ROW 3: MAIN 3-COLUMN BLITZ VIEW ==================== -->
        <Border Grid.Row="3" Background="#13151C" BorderBrush="#20222D" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== LEFT SIDEBAR: BUILDS & OTP BUILDS (NO PRO BUILDS) ========== -->
                <Grid Grid.Column="0" Margin="12,12,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sort Tabs: Win Rate | Common | Crown -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#191B24" BorderBrush="#262936" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,8,0">
                            <UniformGrid Columns="2">
                                <Button x:Name="SortWrBtn" Style="{StaticResource SortTabBtnStyle}" Content="Win Rate" Tag="WINRATE" Background="#F0F2F5" Foreground="#13151C" FontWeight="Bold" Click="SortTab_Click"/>
                                <Button x:Name="SortCommonBtn" Style="{StaticResource SortTabBtnStyle}" Content="Common" Tag="COMMON" Background="Transparent" Foreground="#8E92A4" FontWeight="SemiBold" Click="SortTab_Click"/>
                            </UniformGrid>
                        </Border>

                        <Button x:Name="SortOtpCrownBtn" Grid.Column="1" Tag="OTP" Width="36" Height="36" Background="#191B24" BorderBrush="#262936" BorderThickness="1" Cursor="Hand" Click="SortTab_Click" ToolTip="OTP Builds">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CrownBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CrownBd" Property="BorderBrush" Value="#F0A548"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="👑" FontSize="14" Foreground="#F0A548" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Scrollable Builds List -->
                    <ScrollViewer x:Name="BuildsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Standard Tier Builds Section -->
                            <StackPanel x:Name="StandardBuildsSection">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <Image x:Name="StandardBuildsTierImg" Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-shared-components/global/default/emerald.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="StandardBuildsHeaderText" Text="Emerald+ Builds" Foreground="#2CE5B5" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="StandardBuildsPanel"/>
                            </StackPanel>

                            <!-- Matchup Builds Section (Placed Directly Under Normal Builds) -->
                            <StackPanel x:Name="MatchupBuildsSection" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="MatchupBuildsHeaderText" Text="Matchup Builds (vs Camille)" Foreground="#8E92A4" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,8"/>
                                <StackPanel x:Name="MatchupBuildsPanel"/>
                            </StackPanel>

                            <!-- Champion OTP Builds Section -->
                            <StackPanel x:Name="OtpBuildsSection" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <TextBlock Text="👑 " Foreground="#F0A548" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OtpBuildsHeaderText" Text="Aatrox OTP Builds" Foreground="#F0A548" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="OtpBuildsPanel"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="1" Fill="#20222D"/>

                <!-- ========== CENTER PANEL: RUNES & ABILITY MAX ORDER ========== -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,18,14">
                    <StackPanel>
                        <!-- Runes Header & Selectable Rune Options Row -->
                        <TextBlock Text="Runes" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <WrapPanel x:Name="RuneOptionsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                        <!-- Interactive Rune Trees Visualizer -->
                        <StackPanel x:Name="InteractiveRuneBuilder" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <Rectangle Height="1" Fill="#20222D" Margin="0,4,0,14"/>

                        <!-- Ability Max Order Section -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Ability Priority Summary (Q > E > W) -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Ability Max Order" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#123837" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock x:Name="SkillOrderWrText" Text="62%" Foreground="#2CE5B5" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock x:Name="SkillOrderGamesText" Text="15,683 GAMES" Foreground="#8E92A4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel x:Name="SkillPriorityPanel" Orientation="Horizontal"/>
                            </StackPanel>

                            <!-- Right: 1-18 Ability Level Grid -->
                            <Grid x:Name="SkillOrderGridContainer" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Vertical Divider -->
                <Rectangle Grid.Column="3" Fill="#20222D"/>

                <!-- ========== RIGHT PANEL: SUMMONER SPELLS & ITEMS ========== -->
                <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,16,14">
                    <StackPanel>
                        <!-- Summoner Spells Header -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Summoner Spells" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RightPatchText" Text="Patch: 26.22" Foreground="#6E7385" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Top 2 Summoner Spell Combos -->
                        <StackPanel x:Name="SpellOptionsPanel" Margin="0,0,0,14"/>

                        <!-- Items Header -->
                        <TextBlock Text="Items" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,2,0,8"/>

                        <!-- Dynamic Item Sections (Starting Items, Build Order, Completed Items, Situational Items) -->
                        <StackPanel x:Name="InteractiveItemBuilder"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================== OVERLAY 1: ITEM PICKER ==================== -->
        <Grid x:Name="ItemPickerOverlay" Background="#B2000000" Visibility="Collapsed" Grid.RowSpan="3">
            <Border Background="#161820" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="10" Width="640" Height="480" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="SELECT AN ITEM" Foreground="#EBCB8B" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" Foreground="#8E92A4" BorderThickness="0" Cursor="Hand" Click="CloseItemPicker_Click" FontWeight="Bold"/>
                    </Grid>
                    <TextBox x:Name="ItemSearchBox" Grid.Row="1" Margin="0,12,0,12" Background="#222532" Foreground="White" BorderThickness="0" Padding="10,8" FontSize="13" TextChanged="ItemSearchBox_TextChanged"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="AllItemsWrapPanel" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== OVERLAY 2: CHAMPION / MATCHUP PICKER ==================== -->
        <Grid x:Name="ChampPickerOverlay" Background="#B2000000" Visibility="Collapsed" Grid.RowSpan="3">
            <Border Background="#161820" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="10" Width="660" Height="500" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="ChampPickerTitleText" Text="SELECT CHAMPION" Foreground="#2CE5B5" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" Foreground="#8E92A4" BorderThickness="0" Cursor="Hand" Click="CloseChampPicker_Click" FontWeight="Bold"/>
                    </Grid>
                    <TextBox x:Name="ChampSearchBox" Grid.Row="1" Margin="0,12,0,12" Background="#222532" Foreground="White" BorderThickness="0" Padding="10,8" FontSize="13" TextChanged="ChampSearchBox_TextChanged"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="AllChampsWrapPanel" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
