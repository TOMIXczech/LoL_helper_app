<UserControl x:Class="LoLHelper.PCClient.Views.ChampSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="RUNE AUTO-IMPORTER" Foreground="#FFFFFF" FontSize="22" FontWeight="Black" Margin="0,0,0,20"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- Presets List (Left Side) -->
            <Border Background="#1C1C21" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="HoveredChampText" Text="AVAILABLE PRESETS" Foreground="#8F91A3" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10" x:Name="RoleFilterGrid">
                        <UniformGrid.Resources>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#2D2D35"/>
                                <Setter Property="Foreground" Value="#8F91A3"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Resources>
                        <ToggleButton x:Name="FilterTop" Click="RoleFilter_Click" Tag="TOP">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-top.png" Width="24" Height="24" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterJgl" Click="RoleFilter_Click" Tag="JUNGLE">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-jungle.png" Width="24" Height="24" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterMid" Click="RoleFilter_Click" Tag="MIDDLE">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-middle.png" Width="24" Height="24" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterBot" Click="RoleFilter_Click" Tag="BOTTOM">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-bottom.png" Width="24" Height="24" Stretch="Uniform"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilterSup" Click="RoleFilter_Click" Tag="UTILITY">
                            <Image Source="https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-utility.png" Width="24" Height="24" Stretch="Uniform"/>
                        </ToggleButton>
                    </UniformGrid>
                    
                    <ListBox x:Name="PresetsList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PresetsList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="#2D2D35"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Padding" Value="15"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#007ACC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding RunePreset.Name}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding RunePreset.Description}" Foreground="#D0D0D0" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="SUMMONER SPELLS" Foreground="#8F91A3" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#2D2D35" CornerRadius="4" Padding="5" Cursor="Hand" MouseLeftButtonDown="Spell1_MouseDown">
                                <Border.ContextMenu>
                                    <ContextMenu x:Name="Spell1Menu" />
                                </Border.ContextMenu>
                                <Image x:Name="Spell1Img" Width="32" Height="32" Stretch="Uniform" />
                            </Border>
                            
                            <Border Grid.Column="2" Background="#2D2D35" CornerRadius="4" Padding="5" Cursor="Hand" MouseLeftButtonDown="Spell2_MouseDown">
                                <Border.ContextMenu>
                                    <ContextMenu x:Name="Spell2Menu" />
                                </Border.ContextMenu>
                                <Image x:Name="Spell2Img" Width="32" Height="32" Stretch="Uniform" />
                            </Border>
                        </Grid>
                        
                        <Button x:Name="InjectRunesBtn" 
                                Content="Inject Selected Preset" 
                                Background="#E84057" Foreground="White" FontWeight="Bold" FontSize="14"
                                Height="40" Margin="0,15,0,0" BorderThickness="0" Cursor="Hand"
                                Click="InjectRunesBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live Active Rune Page (Right Side) -->
            <Border Grid.Column="2" Background="#1C1C21" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CUSTOM RUNE BUILDER" Foreground="#A3BE8C" FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>
                        <TextBlock x:Name="ActivePageNameText" Text="(Editing Active Page)" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,20" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Main Dynamic Rune Visualizer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Rune Builder -->
                            <StackPanel x:Name="InteractiveRuneBuilder" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                            
                            <Rectangle Height="2" Fill="#2D2D35" Margin="0,30,0,20"/>
                            
                            <TextBlock Text="CUSTOM ITEM BUILDER" Foreground="#EBCB8B" FontSize="12" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Left"/>
                            <!-- Item Builder -->
                            <StackPanel x:Name="InteractiveItemBuilder" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ITEM PICKER OVERLAY -->
        <Grid x:Name="ItemPickerOverlay" Background="#99000000" Visibility="Collapsed" Grid.RowSpan="2">
            <Border Background="#1C1C21" CornerRadius="12" Width="650" Height="500" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid>
                        <TextBlock Text="SELECT AN ITEM" Foreground="#EBCB8B" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        <Button Content="X" Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent" Foreground="#8F91A3" BorderThickness="0" Cursor="Hand" Click="CloseItemPicker_Click" FontWeight="Bold"/>
                    </Grid>
                    
                    <TextBox x:Name="ItemSearchBox" Grid.Row="1" Margin="0,15,0,15" Background="#2D2D35" Foreground="White" BorderThickness="0" Padding="10" FontSize="14" TextChanged="ItemSearchBox_TextChanged"/>
                    
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="AllItemsWrapPanel" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
