<UserControl x:Class="LoLHelper.PCClient.Views.MobilePairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="MOBILE COMPANION SETUP" Foreground="#FFFFFF" FontSize="22" FontWeight="Black" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <TextBlock Text="Scan this QR code with the iOS/Android app to link your devices." Foreground="#8F91A3" FontSize="14" Margin="0,0,0,30" HorizontalAlignment="Center"/>
            
            <Border Background="White" Width="200" Height="200" CornerRadius="8" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,30">
                <!-- Mock QR Code using a grid of blocks, or just a simple placeholder text -->
                <Grid Background="Black">
                    <TextBlock Text="[ QR CODE PLACEHOLDER ]" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Grid>
            </Border>
            
            <TextBlock Text="Server Status: Running on 192.168.1.55:8080" Foreground="#A3BE8C" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Connected Devices: 0" Foreground="#EBCB8B" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
