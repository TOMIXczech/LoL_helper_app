<UserControl x:Class="LoLHelper.PCClient.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0D0E12">
    <UserControl.Resources>
        <!-- Sleek Thin ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2D3142" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Queue Filter Tab Button Style -->
        <Style x:Key="QueueTabBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Background" Value="Transparent"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBd" Property="Background" Value="#222533"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Graph Pill Button Style -->
        <Style x:Key="GraphPillBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Tab Button Style -->
        <Style x:Key="MetricTabBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Glowing Pill Switch Style -->
        <Style x:Key="HomeSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchTrack" Width="44" Height="22" CornerRadius="11" Background="#25293A" BorderBrush="#34394E" BorderThickness="1">
                            <Border x:Name="SwitchThumb" Width="16" Height="16" CornerRadius="8" Background="#8E92A4" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#143D37"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#2CE5B5"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#2CE5B5"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP HERO OVERVIEW CARDS ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD 1: Summoner Profile, Level & XP Bar -->
            <Border Grid.Column="0" Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile Icon + Level Pill -->
                    <Grid Grid.Column="0" Width="72" Height="76" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Border Width="68" Height="68" CornerRadius="14" BorderBrush="#2CE5B5" BorderThickness="2" Background="#1E2130" VerticalAlignment="Top" ClipToBounds="True">
                            <Image x:Name="ProfileIconImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <Border Background="#11131A" BorderBrush="#2CE5B5" BorderThickness="1.5" CornerRadius="8" Padding="7,1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <TextBlock x:Name="SummonerLevelBadgeText" Text="LVL 284" Foreground="#2CE5B5" FontSize="10.5" FontWeight="Black"/>
                        </Border>
                    </Grid>

                    <!-- Name, Status & XP Progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SummonerNameText" Text="Summoner" Foreground="White" FontSize="17" FontWeight="Black" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                <TextBlock x:Name="SummonerTagText" Text="#EUW" Foreground="#7F859C" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="5,1,0,0"/>
                            </StackPanel>

                            <Button x:Name="RefreshProfileBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1F2332" Foreground="#B8C0D8" BorderThickness="0" Cursor="Hand" ToolTip="Refresh Live LCU Profile &amp; Match History" Click="RefreshProfileBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="#2E3346" BorderThickness="1" CornerRadius="5" Padding="7,3">
                                            <TextBlock Text="↻ Sync" Foreground="{TemplateBinding Foreground}" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Connection Status Pill -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <Border x:Name="ProfileSourceBadge" Background="#152F2C" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="ConnectionStatusText" Text="● Live LCU Profile" Foreground="#2CE5B5" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="RegionAndTitleText" Text="• Level Progression" Foreground="#7E849B" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- XP Progress Header -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock x:Name="XpLabelText" Text="XP TO NEXT LEVEL" Foreground="#8E92A4" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="XpValueText" Text="2,140 / 2,880 XP (74%)" Foreground="#D8DEE9" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- XP Bar -->
                        <Border Height="8" Background="#222534" CornerRadius="4" ClipToBounds="True">
                            <Border x:Name="XpProgressFill" HorizontalAlignment="Left" Width="140" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2CE5B5" Offset="0"/>
                                        <GradientStop Color="#5383E8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 2: Ranked Solo/Duo -->
            <Border Grid.Column="1" Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Rank Emblem -->
                    <Border Grid.Column="0" Width="68" Height="68" Background="#1B1E2B" BorderBrush="#282C3E" BorderThickness="1" CornerRadius="12" Padding="4" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Image x:Name="SoloRankIconImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RANKED SOLO / DUO" Foreground="#7E849B" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                            <TextBlock x:Name="SoloRankTierText" Text="EMERALD II" Foreground="#2CE5B5" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                            <Border Background="#1F2434" BorderBrush="#2F354B" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SoloRankLpText" Text="74 LP" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- LP Bar -->
                        <Border Height="6" Background="#222534" CornerRadius="3" ClipToBounds="True" Margin="0,0,0,6">
                            <Border x:Name="SoloLpProgressFill" HorizontalAlignment="Left" Width="90" Background="#2CE5B5" CornerRadius="3"/>
                        </Border>

                        <Grid>
                            <TextBlock x:Name="SoloWlText" Text="68W 53L" Foreground="#A5ACC4" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SoloWrText" Text="56.2% WR" Foreground="#2CE5B5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 3: Ranked Flex -->
            <Border Grid.Column="2" Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Flex Rank Emblem -->
                    <Border Grid.Column="0" Width="68" Height="68" Background="#1B1E2B" BorderBrush="#282C3E" BorderThickness="1" CornerRadius="12" Padding="4" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Image x:Name="FlexRankIconImg" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RANKED FLEX 5v5" Foreground="#7E849B" FontSize="10" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                            <TextBlock x:Name="FlexRankTierText" Text="PLATINUM I" Foreground="#37C8B7" FontSize="16" FontWeight="Black" VerticalAlignment="Center"/>
                            <Border Background="#1F2434" BorderBrush="#2F354B" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FlexRankLpText" Text="42 LP" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- LP Bar -->
                        <Border Height="6" Background="#222534" CornerRadius="3" ClipToBounds="True" Margin="0,0,0,6">
                            <Border x:Name="FlexLpProgressFill" HorizontalAlignment="Left" Width="60" Background="#37C8B7" CornerRadius="3"/>
                        </Border>

                        <Grid>
                            <TextBlock x:Name="FlexWlText" Text="31W 24L" Foreground="#A5ACC4" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FlexWrText" Text="56.4% WR" Foreground="#37C8B7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 4: Last 20 Games KDA & Combat Summary -->
            <Border Grid.Column="3" Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header + Streak Badge -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="LAST 20 GAMES PERFORMANCE" Foreground="#7E849B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border x:Name="StreakBadgeBorder" Background="#2D2218" BorderBrush="#F0B232" BorderThickness="1" CornerRadius="5" Padding="7,1" HorizontalAlignment="Right">
                            <TextBlock x:Name="StreakBadgeText" Text="🔥 4 WIN STREAK" Foreground="#F0B232" FontSize="10" FontWeight="Black"/>
                        </Border>
                    </Grid>

                    <!-- Main KDA + Winrate Split -->
                    <Grid Grid.Row="1" Margin="0,6,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Last20KdaRatioText" Text="3.92 : 1 KDA" Foreground="#2CE5B5" FontSize="18" FontWeight="Black" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Last20AvgKdaText" Text="8.8 / 4.1 / 7.3" Foreground="#D8DEE9" FontSize="12.5" FontWeight="Bold" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="Last20WlText" Text="13W - 7L (65%)" Foreground="White" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- Micro Stats Pills Row -->
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,2,0,0">
                        <Border Background="#1B1E2B" CornerRadius="5" Padding="6,4" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🌾" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AvgCsText" Text="7.8 CS/m" Foreground="#D8DEE9" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1B1E2B" CornerRadius="5" Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⚔️" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AvgDmgText" Text="26.4k DMG" Foreground="#D8DEE9" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1B1E2B" CornerRadius="5" Padding="6,4" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🪙" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AvgGoldText" Text="13.5k Gold" Foreground="#D8DEE9" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1B1E2B" CornerRadius="5" Padding="6,4" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="👁️" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AvgVisionText" Text="29.4 Vis" Foreground="#D8DEE9" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ROW 1: SYNCHRONIZED QUICK AUTOMATION BAR (AUTO ACCEPT & AUTO CHAMP SELECT) ==================== -->
        <Border Grid.Row="1" Background="#14161F" BorderBrush="#262B3E" BorderThickness="1" CornerRadius="10" Padding="14,9" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Auto Accept Switch Box -->
                <Border Grid.Column="0" Background="#191C28" BorderBrush="#262A3C" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="7" Background="#152F2C" BorderBrush="#2CE5B5" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AUTO ACCEPT" Foreground="White" FontSize="12" FontWeight="Black" VerticalAlignment="Center"/>
                                    <Border x:Name="HomeAutoAcceptBadge" Background="#25293A" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeAutoAcceptBadgeText" Text="OFF" Foreground="#8E92A4" FontSize="9" FontWeight="Black"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="HomeAutoAcceptSubText" Text="Latency: 850ms • All Queues" Foreground="#8A90A6" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton x:Name="HomeAutoAcceptSwitch" Style="{StaticResource HomeSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="HomeAutoAcceptSwitch_Click"/>
                    </Grid>
                </Border>

                <!-- 2. Auto Champ Select Switch Box -->
                <Border Grid.Column="1" Background="#191C28" BorderBrush="#262A3C" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,10,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="7" Background="#18263A" BorderBrush="#5383E8" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="🎯" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AUTO CHAMP SELECT" Foreground="White" FontSize="12" FontWeight="Black" VerticalAlignment="Center"/>
                                    <Border x:Name="HomeAutoSelectBadge" Background="#25293A" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HomeAutoSelectBadgeText" Text="OFF" Foreground="#8E92A4" FontSize="9" FontWeight="Black"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="HomeAutoSelectSubText" Text="Pick: Specific • Ban: #1 Counter" Foreground="#8A90A6" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <ToggleButton x:Name="HomeAutoChampSelectSwitch" Style="{StaticResource HomeSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="HomeAutoChampSelectSwitch_Click"/>
                    </Grid>
                </Border>

                <!-- 3. Live Synchronized Target Pick & Target Ban Preview -->
                <Border Grid.Column="2" Background="#181B26" BorderBrush="#25293A" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Active Pick Preview -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0">
                            <Border Width="30" Height="30" CornerRadius="6" BorderBrush="#2CE5B5" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,8,0">
                                <Image x:Name="HomePreviewPickImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PICK: " Foreground="#7E849B" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomePreviewPickNameText" Text="Yasuo" Foreground="#2CE5B5" FontSize="11.5" FontWeight="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="HomePreviewPickSubText" Text="Specific Main" Foreground="#9BA3BA" FontSize="9.5" TextTrimming="CharacterEllipsis" MaxWidth="135"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#282C3E" Margin="0,2"/>

                        <!-- Active Ban Preview -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,2,0">
                            <Border Width="30" Height="30" CornerRadius="6" BorderBrush="#E84057" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,8,0">
                                <Image x:Name="HomePreviewBanImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BAN: " Foreground="#7E849B" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HomePreviewBanNameText" Text="Vex" Foreground="#E84057" FontSize="11.5" FontWeight="Black" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="HomePreviewBanSubText" Text="#1 Counter to Yasuo" Foreground="#D8B4BE" FontSize="9.5" TextTrimming="CharacterEllipsis" MaxWidth="135"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Open Full Automation Settings Button -->
                <Button Grid.Column="3" x:Name="HomeOpenSettingsBtn" Cursor="Hand" VerticalAlignment="Center" Click="HomeOpenSettingsBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CfgBd" Background="#202538" BorderBrush="#353D5B" BorderThickness="1" CornerRadius="8" Padding="13,9">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Automation Settings" Foreground="White" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CfgBd" Property="Background" Value="#2A314A"/>
                                    <Setter TargetName="CfgBd" Property="BorderBrush" Value="#5383E8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: MAIN DASHBOARD BODY ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Performance Graph, Top Champions & Role Breakdown -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <!-- 1. Match Form Performance Graph (Replaces 20-Game Form) -->
                    <Border Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Header: Title, Metric Badge, and Game Range (20G / 30G / 50G) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="PERFORMANCE GRAPH" Foreground="#8E92A4" FontSize="11" FontWeight="Bold"/>
                                        <Border x:Name="GraphMetricBadge" Background="#162D29" BorderBrush="#2CE5B5" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="GraphMetricBadgeText" Text="RANK &amp; LP" Foreground="#2CE5B5" FontSize="9" FontWeight="Black"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="GraphSubheaderText" Text="Rank: EMERALD II 74 LP • +6 Net Momentum" Foreground="#656B82" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Game count toggle pills: 20G / 30G / 50G -->
                                <Border Grid.Column="1" Background="#1A1D29" BorderBrush="#282D3E" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="GraphBtn20" Content="20G" Tag="20" Click="GraphGameCount_Click" Style="{StaticResource GraphPillBtnStyle}" Background="#25293A" Foreground="White"/>
                                        <Button x:Name="GraphBtn30" Content="30G" Tag="30" Click="GraphGameCount_Click" Style="{StaticResource GraphPillBtnStyle}" Background="Transparent" Foreground="#8E92A4"/>
                                        <Button x:Name="GraphBtn50" Content="50G" Tag="50" Click="GraphGameCount_Click" Style="{StaticResource GraphPillBtnStyle}" Background="Transparent" Foreground="#8E92A4"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Dual Win/Loss Ratio Bar -->
                            <Grid Height="6" Margin="0,0,0,8" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="WinBarCol" Width="65*"/>
                                    <ColumnDefinition x:Name="LossBarCol" Width="35*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#2CE5B5" CornerRadius="3,0,0,3" Margin="0,0,1,0"/>
                                <Border Grid.Column="1" Background="#E84057" CornerRadius="0,3,3,0" Margin="1,0,0,0"/>
                            </Grid>

                            <!-- Metric Switcher Pills: Rank & LP, KDA, CS/m -->
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="MetricBtnRank" Content="🏆 Rank &amp; LP" Tag="RANK" Click="GraphMetric_Click" Style="{StaticResource MetricTabBtnStyle}" Background="#1F332E" Foreground="#2CE5B5"/>
                                    <Button x:Name="MetricBtnKda" Content="⚔️ KDA Ratio" Tag="KDA" Click="GraphMetric_Click" Style="{StaticResource MetricTabBtnStyle}" Background="Transparent" Foreground="#8E92A4"/>
                                    <Button x:Name="MetricBtnCs" Content="🌾 CS/min" Tag="CS" Click="GraphMetric_Click" Style="{StaticResource MetricTabBtnStyle}" Background="Transparent" Foreground="#8E92A4"/>
                                </StackPanel>

                                <TextBlock Text="Oldest → Newest" Foreground="#555B6E" FontSize="9.5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- The Graph Canvas Area -->
                            <Grid x:Name="GraphContainer" Height="165" Background="#10121A" ClipToBounds="True" SizeChanged="GraphContainer_SizeChanged">
                                <!-- Guide lines & Y-axis labels -->
                                <Canvas x:Name="GraphGuideCanvas" IsHitTestVisible="False"/>

                                <!-- Smooth Area & Line Curves -->
                                <Canvas x:Name="GraphDrawCanvas" IsHitTestVisible="False"/>

                                <!-- Interactive Data Nodes -->
                                <Canvas x:Name="GraphNodeCanvas" Background="Transparent" MouseLeave="GraphCanvas_MouseLeave"/>

                                <!-- Floating Hover Tooltip Card -->
                                <Border x:Name="GraphHoverCard" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="#191C28" BorderBrush="#2CE5B5" BorderThickness="1.5" CornerRadius="8" Padding="10,8"
                                        IsHitTestVisible="False" Panel.ZIndex="100">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="HoverChampBorder" Width="36" Height="36" CornerRadius="8" BorderBrush="#2CE5B5" BorderThickness="1.5" ClipToBounds="True" Margin="0,0,9,0">
                                            <Image x:Name="HoverChampImg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="HoverChampNameText" Text="Aatrox" Foreground="White" FontSize="11.5" FontWeight="Black"/>
                                                <TextBlock x:Name="HoverRoleText" Text="TOP" Foreground="#7E849B" FontSize="10" FontWeight="Bold" Margin="6,1,0,0"/>
                                                <Border x:Name="HoverResultBadge" Background="#152F2C" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                    <TextBlock x:Name="HoverResultText" Text="VICTORY" Foreground="#2CE5B5" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock x:Name="HoverKdaText" Text="12 / 2 / 9" Foreground="#D8DEE9" FontSize="10.5" FontWeight="Bold"/>
                                                <TextBlock x:Name="HoverMetricValueText" Text="(10.5 KDA)" Foreground="#2CE5B5" FontSize="10.5" FontWeight="Bold" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <TextBlock x:Name="HoverMetaText" Text="Ranked Solo • 29m • 2h ago" Foreground="#7E849B" FontSize="9.5" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Bottom Micro Legend / Win-Loss Mini Ticks -->
                            <Grid Margin="0,7,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#2CE5B5" Margin="0,0,4,0"/>
                                    <TextBlock Text="Victory" Foreground="#2CE5B5" FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <Ellipse Width="7" Height="7" Fill="#E84057" Margin="0,0,4,0"/>
                                    <TextBlock Text="Defeat" Foreground="#E84057" FontSize="10" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock x:Name="GraphQuickStatsText" Text="Peak Streak: 4W • Avg KDA: 3.92" Foreground="#8E92A4" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Most Played Champions (Last 20 Games) -->
                    <Border Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="MOST PLAYED CHAMPIONS (LAST 20)" Foreground="#8E92A4" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="Click to open build" Foreground="#5383E8" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel x:Name="TopChampionsStack"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Role Breakdown (with CDragon Role Icons) -->
                    <Border Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="ROLE PERFORMANCE (LAST 20)" Foreground="#8E92A4" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel x:Name="RoleBreakdownStack"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT MAIN AREA: Last 20 Games Match History Feed -->
            <Border Grid.Column="1" Background="#14161F" BorderBrush="#232736" BorderThickness="1" CornerRadius="10" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Match History Header & Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="MATCH HISTORY" Foreground="White" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <Button x:Name="FilterAllBtn" Content="All Games (20)" Style="{StaticResource QueueTabBtnStyle}" Background="#25293A" Foreground="White" Tag="ALL" Click="QueueFilter_Click"/>
                            <Button x:Name="FilterSoloBtn" Content="Ranked Solo" Style="{StaticResource QueueTabBtnStyle}" Background="Transparent" Foreground="#8E92A4" Tag="SOLO" Click="QueueFilter_Click"/>
                            <Button x:Name="FilterFlexBtn" Content="Ranked Flex" Style="{StaticResource QueueTabBtnStyle}" Background="Transparent" Foreground="#8E92A4" Tag="FLEX" Click="QueueFilter_Click"/>
                            <Button x:Name="FilterOtherBtn" Content="Normal / ARAM" Style="{StaticResource QueueTabBtnStyle}" Background="Transparent" Foreground="#8E92A4" Tag="OTHER" Click="QueueFilter_Click"/>
                        </StackPanel>

                        <!-- Champion Search Filter -->
                        <Border HorizontalAlignment="Right" Width="210" Height="30" Background="#1C1F2B" BorderBrush="#2C3144" BorderThickness="1" CornerRadius="6" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="#7E849B" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="MatchSearchBox" Grid.Column="1" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="11.5" TextChanged="MatchSearchBox_TextChanged"/>
                                <TextBlock x:Name="MatchSearchPlaceholder" Grid.Column="1" Text="Filter by champion..." Foreground="#656B82" FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Scrollable 20-Game List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MatchHistoryListStack"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
