<Window x:Class="LoLHelper.PCClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Helper - Blitz Companion" Height="860" Width="1380"
        MinHeight="720" MinWidth="1150"
        Background="#0D0E12"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sleek Top App Bar -->
        <Border Grid.Row="0" Background="#13141B" BorderBrush="#22242F" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LOL HELPER" Foreground="#FFFFFF" FontSize="15" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <Button x:Name="NavChampSelectBtn" Content="Champion Builds" Height="30" Padding="14,0" Margin="0,0,6,0" Background="#252836" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Nav_Click"/>
                    <Button x:Name="NavDashboardBtn" Content="LCU Status &amp; Logs" Height="30" Padding="14,0" Background="Transparent" Foreground="#8E92A4" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Nav_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="LcuStatusDot" Width="8" Height="8" Fill="#8E92A4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="LcuStatusLabel" Text="Waiting for League Client..." Foreground="#8E92A4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area where Views are loaded -->
        <ContentControl x:Name="MainContentArea" Grid.Row="1"/>
    </Grid>
</Window>
